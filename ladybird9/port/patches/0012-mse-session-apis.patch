+// https://w3c.github.io/media-source/#dom-mediasource-removesourcebuffer
+void SourceBuffer::remove_all_tracks(Badge<MediaSource>)
+{
+    auto media_element = m_media_source->media_element_assigned_to();
+
+    auto queue_removetrack_event = [&](auto track, auto track_list) {
+        // Queue a task to fire an event named removetrack, that does not bubble and is not cancelable, and that
+        // uses the TrackEvent interface, with the track attribute initialized to the track object, at the
+        // HTMLMediaElement track list.
+        m_media_source->queue_a_media_source_task(GC::create_function(heap(), [track, track_list] {
+            Bindings::TrackEventInit event_init {};
+            event_init.track = track;
+            track_list->dispatch_event(HTML::TrackEvent::create(track_list->realm(), HTML::EventNames::removetrack, move(event_init)));
+        }));
+    };
+
+    // 3. Let SourceBuffer audioTracks list equal the AudioTrackList object returned by sourceBuffer.audioTracks.
+    // 4. If the SourceBuffer audioTracks list is not empty, then run the following steps:
+    //    1. For each AudioTrack object in the SourceBuffer audioTracks list, run the following steps:
+    m_audio_tracks->for_each_track([&](HTML::AudioTrack& audio_track) {
+        // FIXME: 1. Set the sourceBuffer attribute on the AudioTrack object to null.
+
+        // 2. Remove the AudioTrack object from the HTMLMediaElement audioTracks list.
+        // NB: Disabling the track in the PlaybackManager is handled by remove_media_source() below.
+        if (media_element) {
+            media_element->audio_tracks()->remove_track(audio_track);
+
+            // 3. Queue a task to fire an event named removetrack at the HTMLMediaElement audioTracks list.
+            queue_removetrack_event(GC::Ref(audio_track), media_element->audio_tracks());
+        }
+        return IterationDecision::Continue;
+    });
+    // 2. (cont.) Remove the AudioTrack objects from the SourceBuffer audioTracks list.
+    m_audio_tracks->remove_all_tracks();
+
+    // 5. Let SourceBuffer videoTracks list equal the VideoTrackList object returned by sourceBuffer.videoTracks.
+    // 6. If the SourceBuffer videoTracks list is not empty, then run the following steps:
+    //    1. For each VideoTrack object in the SourceBuffer videoTracks list, run the following steps:
+    m_video_tracks->for_each_track([&](HTML::VideoTrack& video_track) {
+        // FIXME: 1. Set the sourceBuffer attribute on the VideoTrack object to null.
+
+        // AD-HOC: Unselect the track first, so that the media element releases its displaying video sink while
+        //         the track still exists in the PlaybackManager.
+        video_track.set_selected(false);
+
+        // 2. Remove the VideoTrack object from the HTMLMediaElement videoTracks list.
+        if (media_element) {
+            media_element->video_tracks()->remove_track(video_track);
+
+            // 3. Queue a task to fire an event named removetrack at the HTMLMediaElement videoTracks list.
+            queue_removetrack_event(GC::Ref(video_track), media_element->video_tracks());
+        }
+        return IterationDecision::Continue;
+    });
+    // 2. (cont.) Remove the VideoTrack objects from the SourceBuffer videoTracks list.
+    m_video_tracks->remove_all_tracks();
+
+    // 7. Let SourceBuffer textTracks list equal the TextTrackList object returned by sourceBuffer.textTracks.
+    // 8. If the SourceBuffer textTracks list is not empty, then run the following steps:
+    //    1. For each TextTrack object in the SourceBuffer textTracks list, run the following steps:
+    Vector<GC::Ref<HTML::TextTrack>> text_tracks;
+    m_text_tracks->for_each_track([&](HTML::TextTrack& text_track) {
+        text_tracks.append(GC::Ref(text_track));
+        return IterationDecision::Continue;
+    });
+    for (auto const& text_track : text_tracks) {
+        // FIXME: 1. Set the sourceBuffer attribute on the TextTrack object to null.
+
+        // 2. Remove the TextTrack object from the HTMLMediaElement textTracks list.
+        m_text_tracks->remove_track(text_track);
+        if (media_element) {
+            media_element->text_tracks()->remove_track(text_track);
+
+            // 3. Queue a task to fire an event named removetrack at the HTMLMediaElement textTracks list.
+            queue_removetrack_event(text_track, media_element->text_tracks());
+        }
+    }
+
+    // 11. Destroy all resources for sourceBuffer.
+    // AD-HOC: Unregister our track buffer demuxers from the media element's PlaybackManager so that its decoders
+    //         stop reading from them. The remaining resources are garbage collected.
+    if (media_element) {
+        for (auto const& demuxer : m_demuxers_in_playback_manager)
+            media_element->playback_manager().remove_media_source(demuxer);
+    }
+    m_demuxers_in_playback_manager.clear();
+}
