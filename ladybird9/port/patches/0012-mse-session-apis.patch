+<!DOCTYPE html>
+<video id="video"></video>
+<script src="../include.js"></script>
+<script>
+    asyncTest(done => {
+        function step(text) {
+            println(text);
+        }
+
+        function fail(name, error) {
+            println(`FAIL: ${name}: ${error}`);
+            done();
+        }
+
+        try {
+            const video = document.getElementById("video");
+            const mimeType = 'video/webm;codecs="vp9,opus"';
+            const mediaSource = new MediaSource();
+            video.src = URL.createObjectURL(mediaSource);
+
+            // The test WebM file has:
+            //   Init segment: bytes 0-529
+            //   Cluster 1 (0ms): bytes 530-946884
+            //   Cluster 2 (4981ms): bytes 946885-1605920, no video keyframes
+            //   Cluster 3 (9601ms): bytes 1605921-end, starts with a video keyframe
+            mediaSource.addEventListener("sourceopen", async () => {
+                try {
+                    const sourceBuffer = mediaSource.addSourceBuffer(mimeType);
+
+                    const response = await fetch("../../../Assets/test-webm.webm");
+                    if (!response.ok) {
+                        fail("fetch", `HTTP ${response.status}`);
+                        return;
+                    }
+                    const data = await response.arrayBuffer();
+
+                    // Append the entire file: init segment plus all three clusters.
+                    await new Promise((resolve, reject) => {
+                        sourceBuffer.addEventListener("updateend", resolve, { once: true });
+                        sourceBuffer.addEventListener("error", () => reject(new Error("error")), { once: true });
+                        sourceBuffer.appendBuffer(data);
+                    });
+
+                    const before = sourceBuffer.buffered;
+                    step(`ranges before remove: ${before.length}`);
+                    const startBefore = before.start(0);
+                    const endBefore = before.end(0);
+
+                    // remove() argument validation.
+                    for (const [start, end] of [[-1, 5], [5, 5], [5, NaN]]) {
+                        try {
+                            sourceBuffer.remove(start, end);
+                            step(`remove(${start}, ${end}): no exception`);
+                        } catch (e) {
+                            step(`remove(${start}, ${end}): ${e.name}`);
+                        }
+                    }
+
+                    // Remove the middle of the buffered range. Cluster 3 starts with a video
+                    // keyframe at ~9.604s, so the removal should stop there.
+                    const events = [];
+                    for (const name of ["updatestart", "update", "updateend"])
+                        sourceBuffer.addEventListener(name, () => events.push(name));
+                    await new Promise((resolve, reject) => {
+                        sourceBuffer.addEventListener("updateend", resolve, { once: true });
+                        sourceBuffer.addEventListener("error", () => reject(new Error("error")), { once: true });
+                        sourceBuffer.remove(5.004, 9.604);
+                        step(`updating during remove: ${sourceBuffer.updating}`);
+                    });
+                    step(`events: ${events.join(", ")}`);
+
+                    const after = sourceBuffer.buffered;
+                    step(`ranges after remove: ${after.length}`);
+                    step(`range 0 start unchanged: ${after.start(0) === startBefore}`);
+                    step(`range 0 ends at removed range: ${after.end(0) <= 5.005}`);
+                    step(`range 1 starts after removed range: ${after.length > 1 && after.start(1) >= 9.6}`);
+                    step(`range 1 end unchanged: ${after.length > 1 && after.end(1) === endBefore}`);
+
+                    // timestampOffset round-trips.
+                    step(`timestampOffset default: ${sourceBuffer.timestampOffset}`);
+                    sourceBuffer.timestampOffset = 2.5;
+                    step(`timestampOffset: ${sourceBuffer.timestampOffset}`);
+                    sourceBuffer.timestampOffset = 0;
+
+                    // appendWindowStart/appendWindowEnd round-trip and validate.
+                    step(`appendWindowStart default: ${sourceBuffer.appendWindowStart}`);
+                    step(`appendWindowEnd default: ${sourceBuffer.appendWindowEnd}`);
+                    sourceBuffer.appendWindowStart = 1.5;
+                    sourceBuffer.appendWindowEnd = 10;
+                    step(`appendWindowStart: ${sourceBuffer.appendWindowStart}`);
+                    step(`appendWindowEnd: ${sourceBuffer.appendWindowEnd}`);
+                    try {
+                        sourceBuffer.appendWindowStart = -1;
+                        step("appendWindowStart = -1: no exception");
+                    } catch (e) {
+                        step(`appendWindowStart = -1: ${e.name}`);
+                    }
+
+                    // removeSourceBuffer() removes the buffer without throwing.
+                    mediaSource.removeSourceBuffer(sourceBuffer);
+                    step(`sourceBuffers length after removeSourceBuffer: ${mediaSource.sourceBuffers.length}`);
+                    step(`activeSourceBuffers length after removeSourceBuffer: ${mediaSource.activeSourceBuffers.length}`);
+                    try {
+                        mediaSource.removeSourceBuffer(sourceBuffer);
+                        step("second removeSourceBuffer: no exception");
+                    } catch (e) {
+                        step(`second removeSourceBuffer: ${e.name}`);
+                    }
+                    done();
+                } catch (e) {
+                    fail("sourceopen handler", e);
+                }
+            });
+        } catch (e) {
+            fail("setup", e);
+        }
+    });
+</script>
