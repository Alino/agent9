+void PlaybackManager::remove_media_source(NonnullRefPtr<Demuxer> const& demuxer)
+{
+    // Tear down all tracks that were registered by this demuxer, undoing the work of add_media_source().
+    auto video_tracks_or_error = demuxer->get_tracks_for_type(TrackType::Video);
+    if (!video_tracks_or_error.is_error()) {
+        for (auto const& track : video_tracks_or_error.value()) {
+            // Wake up any decoder threads blocked on reads from this demuxer so their producers can exit.
+            demuxer->set_blocking_reads_aborted_for_track(track);
+
+            for (size_t i = 0; i < m_video_track_datas.size(); i++) {
+                if (m_video_track_datas[i].track != track)
+                    continue;
+                if (m_video_track_datas[i].display != nullptr)
+                    remove_the_displaying_video_sink_for_track(track);
+                m_video_track_datas.remove(i);
+                break;
+            }
+            m_video_tracks.remove_first_matching([&](auto const& existing_track) { return existing_track == track; });
+            if (m_preferred_video_track.has_value() && *m_preferred_video_track == track)
+                m_preferred_video_track = {};
+        }
+    }
+
+    auto audio_tracks_or_error = demuxer->get_tracks_for_type(TrackType::Audio);
+    if (!audio_tracks_or_error.is_error()) {
+        for (auto const& track : audio_tracks_or_error.value()) {
+            demuxer->set_blocking_reads_aborted_for_track(track);
+
+            for (size_t i = 0; i < m_audio_track_datas.size(); i++) {
+                if (m_audio_track_datas[i].track != track)
+                    continue;
+                if (m_audio_track_datas[i].enabled)
+                    disable_an_audio_track(track);
+                m_audio_track_datas.remove(i);
+                break;
+            }
+            m_audio_tracks.remove_first_matching([&](auto const& existing_track) { return existing_track == track; });
+            if (m_preferred_audio_track.has_value() && *m_preferred_audio_track == track)
+                m_preferred_audio_track = {};
+        }
+    }
+
+    update_pipeline_state();
+}
