new file mode 100644
index 0000000000..82d4a03a0b
--- /dev/null
+++ b/UI/Plan9/Plan9WebView.h
@@ -0,0 +1,93 @@
+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Time.h>
+#include <LibWeb/Page/InputEvent.h>
+#include <LibWebView/HeadlessWebView.h>
+
+namespace Ladybird {
+
+// Interactive on-screen view for Plan 9. It is a HeadlessWebView (which already
+// owns the WebContent client, viewport and paint bookkeeping) whose painted
+// front bitmap is streamed to the gl9win2 presenter as GL9B frames (fd), and
+// which is driven by the 16-byte input records the presenter writes back
+// (decoded per alacritty9/PROTOCOL.md).
+class Plan9WebView final : public WebView::HeadlessWebView {
+public:
+    static NonnullOwnPtr<Plan9WebView> create(Core::AnonymousBuffer theme, Web::DevicePixelSize window_size, int frame_fd);
+
+    // Push the current front bitmap to the presenter as a GL9B full frame.
+    void present();
+
+    // Decode + dispatch one presenter event record.
+    void feed_event(u8 type, u8 state, u16 modifiers, u32 a, u32 b);
+
+    // Chrome commands from the presenter (address bar / nav buttons).
+    void navigate(StringView text);   // sanitize URL-vs-search, then load
+    void go_back();
+    void go_forward();
+    void reload_page();
+    void stop();
+
+    // Only the active tab streams frames + its URL/nav state to the presenter.
+    void set_active(bool);
+    bool is_active() const { return m_active; }
+
+    // For the coordinator's tab-strip (GL9K) + address bar (UTF-8 bytes).
+    ByteString current_title() const;
+    ByteString current_url() const;
+
+    // The coordinator wires this to re-emit the tab list on title changes.
+    Function<void()> on_chrome_state_changed;
+    Function<void()> on_quit;
+
+    // Emit the active tab's URL (GL9U) + load/nav state (GL9L) to the presenter.
+    void emit_chrome_state();
+
+private:
+    Plan9WebView(Core::AnonymousBuffer theme, Web::DevicePixelSize size, int frame_fd);
+
+    void dispatch_mouse(Web::MouseEvent::Type, Web::UIEvents::MouseButton changed_button, u16 modifiers, double wheel_y = 0);
+    void dispatch_key(bool down, u32 rune, u16 modifiers);
+
+    // The compositor's damage rect for the frame that is ABOUT to be presented:
+    // ViewImplementation calls this immediately before on_ready_to_paint, and it
+    // is the only place the damage information still exists in the UI process.
+    // present() consumes it to decide GL9D (sub-rect) vs GL9B (full frame).
+    virtual void did_accept_presented_backing_store(i32, Gfx::IntRect damage_rect) override
+    {
+        m_pending_damage = damage_rect;
+    }
+
+    int m_frame_fd { 1 };
+    bool m_active { true };
+    Gfx::IntRect m_pending_damage;
+    // Size of the last frame the presenter actually received. A GL9D delta is
+    // only valid against a retained image of the SAME size; anything else (first
+    // frame, resize, tab switch) must resend a full GL9B.
+    Gfx::IntSize m_last_sent_size;
+    // Reused wire-staging buffer so a frame goes out as ONE write(2) instead of
+    // one syscall per scanline.
+    ByteBuffer m_staging;
+    // $LB9_PRESENT_STATS=1: count full/partial frames + bytes, report per 100.
+    bool m_present_stats { false };
+    u32 m_stat_full { 0 };
+    u32 m_stat_partial { 0 };
+    u32 m_stat_damage_samples { 0 };
+    u64 m_stat_bytes { 0 };
+    Gfx::IntPoint m_mouse;
+    Web::UIEvents::MouseButton m_buttons { Web::UIEvents::MouseButton::None };
+
+    // Multi-click detection (mirrors UI/Qt/WebContentView.cpp): consecutive
+    // MouseDowns close in time and position raise click_count for dbl/triple-click.
+    int m_click_count { 0 };
+    MonotonicTime m_last_click_time { MonotonicTime::now() };
+    Gfx::IntPoint m_last_click_position;
+};
+
+}
diff --git a/UI/Plan9/main.cpp b/UI/Plan9/main.cpp
new file mode 100644
index 0000000000..3d011d98ff
--- /dev/null
+++ b/UI/Plan9/main.cpp
@@ -0,0 +1,208 @@
+/*
+ * Copyright (c) 2026, the Ladybird developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/ByteBuffer.h>
+#include <AK/ByteString.h>
+#include <AK/LexicalPath.h>
+#include <LibCore/EventLoop.h>
+#include <LibCore/Notifier.h>
+#include <LibGfx/SystemTheme.h>
+#include <LibMain/Main.h>
+#include <LibWebView/Application.h>
+#include <LibWebView/Utilities.h>
+#include <UI/Plan9/Application.h>
+#include <UI/Plan9/Plan9BrowserWindow.h>
+
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+// Read exactly n bytes from fd 0 (the presenter event stream); false on EOF.
+static bool read_exact(void* buf, size_t n)
+{
+    auto* p = static_cast<u8*>(buf);
+    size_t got = 0;
+    while (got < n) {
+        auto r = ::read(0, p + got, n - got);
+        if (r <= 0)
+            return false;
+        got += static_cast<size_t>(r);
+    }
+    return true;
+}
+
+// Bytes already buffered on the presenter event stream (0 when unknowable).
+// Drives the drain loop below: gl9win2 emits one 16-byte record per wheel
+// notch / mouse move with no coalescing of its own, so under a scroll flood
+// the pipe holds a queue of them.
+static size_t input_bytes_pending()
+{
+    int n = 0;
+    if (::ioctl(0, FIONREAD, &n) < 0 || n < 0)
+        return 0;
+    return static_cast<size_t>(n);
+}
+
+ErrorOr<int> ladybird_main(Main::Arguments arguments)
+{
+    AK::set_rich_debug_enabled(true);
+
+    // Interactive vs headless has to be decided from the raw args BEFORE
+    // Application::create(), because create() → launch_services() eagerly spawns
+    // RequestServer/ImageDecoder/Compositor. Interactively fd 1 is gl9win2's frame
+    // pipe, so we must move it aside first — otherwise those helpers inherit the
+    // frame pipe as their stdout and a stray write corrupts the frame stream.
+    bool headless = false;
+    for (auto arg : arguments.strings) {
+        if (arg == "--headless"sv || arg.starts_with("--headless="sv)) {
+            headless = true;
+            break;
+        }
+    }
+
+    int frame_fd = -1;
+    if (!headless) {
+        frame_fd = ::dup(1);
+        if (frame_fd < 0)
+            return Error::from_errno(errno);
+        // Keep the frame pipe out of every spawned helper (belt-and-suspenders
+        // with the fd-1-aside above; also covers lazily-spawned WebContent).
+        ::fcntl(frame_fd, F_SETFD, FD_CLOEXEC);
+        ::dup2(2, 1); // stdout -> stderr: a stray outln() can't corrupt frames
+    }
+
+    auto app = TRY(Ladybird::Application::create(arguments));
+    if (app->should_exit_after_profile_coordination()) {
+        outln("Opening in existing process");
+        return 0;
+    }
+
+    auto const& options = WebView::Application::browser_options();
+
+    // Headless modes (screenshot/text/layout-tree) are owned by the base flow.
+    if (options.headless_mode.has_value())
+        return app->execute();
+
+    auto theme_path = LexicalPath::join(WebView::s_ladybird_resource_root, "themes"sv, "Default.ini"sv);
+    auto theme = TRY(Gfx::load_system_theme(theme_path.string()));
+
+    Web::DevicePixelSize window_size { options.window_width, options.window_height };
+    auto window = make<Ladybird::Plan9BrowserWindow>(move(theme), window_size, frame_fd);
+
+    auto& event_loop = Core::EventLoop::current();
+    window->on_quit = [&event_loop]() { event_loop.quit(0); };
+
+    // Presenter records arrive on fd 0: 16-byte input events (types 1-7) or
+    // 16-byte chrome commands (type 8; navigate/sub-8 has a trailing UTF-8 URL).
+    auto input_notifier = Core::Notifier::construct(0, Core::Notifier::Type::Read);
+    input_notifier->on_activation = [&window]() {
+        // Drain every record already buffered in ONE activation, coalescing as
+        // we go. gl9win2 writes one 16-byte record per wheel notch and per mouse
+        // move with no merging of its own, and reading a single record per
+        // event-loop turn (as this used to) meant a scroll flood queued behind
+        // full page repaints: each queued notch became its own 120-px wheel
+        // event, its own relayout, its own repaint. Merging a run of notches
+        // into one wheel event does one repaint for the lot; runs of mouse
+        // moves keep only the newest position. Ordering is preserved — any
+        // record of a different type flushes the pending coalesced state first.
+        i32 scroll_accum = 0;
+        u16 scroll_mods = 0;
+        bool have_move = false;
+        u32 move_x = 0, move_y = 0;
+        u16 move_mods = 0;
+
+        auto flush_scroll = [&]() {
+            if (scroll_accum != 0) {
+                window->feed_event(4, 0, scroll_mods, static_cast<u32>(scroll_accum), 0);
+                scroll_accum = 0;
+            }
+        };
+        auto flush_move = [&]() {
+            if (have_move) {
+                window->feed_event(2, 0, move_mods, move_x, move_y);
+                have_move = false;
+            }
+        };
+
+        for (;;) {
+            u8 rec[16];
+            if (!read_exact(rec, sizeof rec)) {
+                if (window->on_quit)
+                    window->on_quit();
+                return;
+            }
+            u8 type = rec[0];
+            u8 state = rec[1];
+            u16 mods = static_cast<u16>((rec[2] << 8) | rec[3]);
+            u32 a = (static_cast<u32>(rec[4]) << 24) | (static_cast<u32>(rec[5]) << 16) | (static_cast<u32>(rec[6]) << 8) | rec[7];
+            u32 b = (static_cast<u32>(rec[8]) << 24) | (static_cast<u32>(rec[9]) << 16) | (static_cast<u32>(rec[10]) << 8) | rec[11];
+
+            if (type == 8) {
+                flush_move();
+                flush_scroll();
+                ByteString text;
+                if (state == 8) { // navigate carries u32be len + UTF-8 URL
+                    u8 lenbuf[4];
+                    if (!read_exact(lenbuf, sizeof lenbuf)) {
+                        if (window->on_quit)
+                            window->on_quit();
+                        return;
+                    }
+                    u32 len = (static_cast<u32>(lenbuf[0]) << 24) | (static_cast<u32>(lenbuf[1]) << 16) | (static_cast<u32>(lenbuf[2]) << 8) | lenbuf[3];
+                    // A URL longer than this is a corrupt/desynced stream, not a real
+                    // navigation. Once the length prefix is wrong we can't tell where
+                    // the next record begins, so tear the presenter connection down
+                    // rather than parse the following URL bytes as input events.
+                    static constexpr u32 max_url_length = 64 * 1024;
+                    if (len > max_url_length) {
+                        if (window->on_quit)
+                            window->on_quit();
+                        return;
+                    }
+                    if (len > 0) {
+                        auto payload_or_error = ByteBuffer::create_uninitialized(len);
+                        // On a short read or alloc failure the len payload bytes are
+                        // left (partly) unconsumed on fd 0, so the stream is desynced
+                        // either way — quit instead of returning to misparse them.
+                        if (payload_or_error.is_error() || !read_exact(payload_or_error.value().data(), len)) {
+                            if (window->on_quit)
+                                window->on_quit();
+                            return;
+                        }
+                        text = ByteString { payload_or_error.value().bytes() };
+                    }
+                }
+                window->handle_command(state, a, text);
+            } else if (type == 2) { // mouse move: keep only the newest position
+                flush_scroll();
+                have_move = true;
+                move_x = a;
+                move_y = b;
+                move_mods = mods;
+            } else if (type == 4) { // wheel notch: accumulate the run
+                flush_move();
+                scroll_accum += static_cast<i32>(a);
+                scroll_mods = mods;
+            } else {
+                flush_move();
+                flush_scroll();
+                window->feed_event(type, state, mods, a, b);
+            }
+
+            // Records are 16 bytes (the CMDNAV tail was consumed above); less
+            // than one full record buffered means the next activation owns it.
+            if (input_bytes_pending() < 16)
+                break;
+        }
+        flush_move();
+        flush_scroll();
+    };
+
+    auto initial_url = options.urls.is_empty() ? ByteString {} : options.urls.first().serialize().to_byte_string();
+    window->open_initial_tab(initial_url);
+
+    return app->execute();
+}
