+            if (!m_internal_stream_data || m_body_delivery_paused)
+                return;
+            if (!m_internal_stream_data->read_stream || !m_internal_stream_data->read_notifier)
+                return;
+            if (auto& activation = m_internal_stream_data->read_notifier->on_activation)
+                activation();
+        });
+        m_internal_stream_data->read_drain_timer->start();
+    }
+#endif
