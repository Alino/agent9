@@ -116,7 +116,14 @@ class WPTContext:
         self.python_script_handler = python_script_handler
         self.http_exception = HTTPException
         self.stash_class = Stash
-        self.stash_manager, self.stash_address, self.stash_authkey = start_stash_server()
+        # python9 (cc9 CPython on 9front) has no working multiprocessing:
+        # start_stash_server() -> manager.start() spawns a child that crashes on
+        # AF_UNIX and pollutes stdout BEFORE any exception reaches us, corrupting
+        # the port line the C++ fixture reads. This is a single-process
+        # ThreadingTCPServer, so skip the cross-process stash entirely and use
+        # wptserve's in-process-dict stash (address/authkey None -> in-process
+        # branch). No child spawns, stdout stays clean.
+        self.stash_manager, self.stash_address, self.stash_authkey = None, None, None
 
     def configure_server(self, port):
         def make_subdomains_product(subdomains, depth=2):
