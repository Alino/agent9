diff --git a/src/nvim/terminal.c b/src/nvim/terminal.c
index 004a002..0d6a19c 100644
--- a/src/nvim/terminal.c
+++ b/src/nvim/terminal.c
@@ -1249,7 +1249,47 @@ static void terminal_send(Terminal *term, const char *data, size_t size)
     kv_concat_len(*term->pending.send, data, size);
     return;
   }
+#ifdef __plan9__
+  // ICRNL, normally the pty line discipline's job: line-reading children (rc)
+  // need '\n', but terminal Enter is '\r'. Translate outgoing input in
+  // chunks. Ceiling: children wanting a raw '\r' (rare full-screen TUIs
+  // inside :terminal) see '\n' instead.
+  {
+    char xl[512];
+    size_t done = 0;
+    while (done < size) {
+      size_t n = MIN(size - done, sizeof(xl));
+      memcpy(xl, data + done, n);
+      for (size_t i = 0; i < n; i++) {
+        if (xl[i] == '\r') {
+          xl[i] = '\n';
+        }
+      }
+      term->opts.write_cb(xl, n, term->opts.data);
+      done += n;
+    }
+  }
+#else
   term->opts.write_cb(data, size, term->opts.data);
+#endif
+#ifdef __plan9__
+  // Pipe-backed "pty" (see pty_proc_unix.c): no kernel echo, so echo locally.
+  // Chunks containing ESC (arrow keys, paste guards) are not echoed; BS/DEL
+  // erases; CR advances a line. TUIs that repaint the screen tolerate the
+  // stray echo; see neovim9 PORT notes.
+  if (memchr(data, 0x1b, size) == NULL) {
+    for (size_t i = 0; i < size; i++) {
+      unsigned char c = (unsigned char)data[i];
+      if (c == '\r' || c == '\n') {
+        terminal_receive(term, "\r\n", 2);
+      } else if (c == 0x7f || c == 0x08) {
+        terminal_receive(term, "\b \b", 3);
+      } else if (c >= 0x20) {
+        terminal_receive(term, (const char *)data + i, 1);
+      }
+    }
+  }
+#endif
 }
 
 static bool is_filter_char(int c)
diff --git a/src/nvim/tui/input.c b/src/nvim/tui/input.c
index 121bcb3..ddf0983 100644
--- a/src/nvim/tui/input.c
+++ b/src/nvim/tui/input.c
@@ -869,10 +869,49 @@ static size_t handle_raw_buffer(TermInput *input, bool force, const char *data,
   return (size_t)(ptr - data);
 }
 
+#ifdef __plan9__
+// A Plan 9 console delivers NL for the Enter key where a terminal emulator sends
+// CR, and there is no line discipline in between to convert it. Every <CR>
+// mapping therefore goes unfired: under `drawterm -G`, pressing Enter on a file
+// in netrw did nothing at all.
+//
+// Rewriting NL->CR costs Ctrl-J, which is not a real loss: the console produces
+// the identical byte for Enter and Ctrl-J, so Ctrl-J was never distinguishable
+// here (exactly as Ctrl-M is not distinguishable from Enter on a Unix tty).
+// Scoped to an actual console by asking the kernel for the fd's path — under
+// alacritty9 stdin is a pipe and CR already arrives correctly, so input there is
+// passed through untouched.
+extern long n9_fd2path(int, char *, int);
+
+static bool tinput_is_plan9_console(int fd)
+{
+  static int cached = -1;
+  if (cached < 0) {
+    char path[128];
+    cached = (n9_fd2path(fd, path, sizeof(path)) >= 0
+              && (strcmp(path, "/dev/cons") == 0 || strcmp(path, "#c/cons") == 0)) ? 1 : 0;
+  }
+  return cached == 1;
+}
+#endif
+
 static size_t tinput_read_cb(RStream *stream, const char *buf, size_t count_, void *data, bool eof)
 {
   TermInput *input = data;
 
+#ifdef __plan9__
+  if (tinput_is_plan9_console(input->in_fd)) {
+    // in place in our own read buffer; re-running over an incomplete sequence
+    // left for the next read is harmless (already-converted bytes are CR)
+    char *p = (char *)buf;
+    for (size_t i = 0; i < count_; i++) {
+      if (p[i] == '\n') {
+        p[i] = '\r';
+      }
+    }
+  }
+#endif
+
   size_t consumed = handle_raw_buffer(input, false, buf, count_);
   tinput_flush(input);
 
