diff --git a/runtime/lua/netrw_fastlist.lua b/runtime/lua/netrw_fastlist.lua
new file mode 100644
index 0000000..255daa7
--- /dev/null
+++ b/runtime/lua/netrw_fastlist.lua
@@ -0,0 +1,79 @@
+-- netrw_fastlist — one-pass local directory listing for netrw.
+-- nvim-plan9: netrw's s:NetrwLocalListingList classifies every entry with
+-- ~4 stat-class vimscript calls plus ~30 interpreted lines — ~8ms/file on a
+-- slow CPU (2.5s for a 300-file directory). This does the same work in one
+-- lua pass. Only the default shapes go through here (thin and wide listings,
+-- sort-by-name); netrw falls back to its own loop otherwise.
+local M = {}
+
+local band = bit.band
+
+-- What one uv.fs_lstat costs, and why it is rationed.
+--
+-- On 9front every stat is a 9P round trip to the file server: measured 133us
+-- on cirno, against 6.7us to pull an entry out of a directory read that
+-- already carries it. Scanning 8000 entries takes 54ms; stat'ing each one as
+-- well takes 1117ms — the stat is ~95% of the listing, and it buys exactly
+-- one thing, the '*' executable marker.
+--
+-- So: mark executables only while the directory is small enough for nobody to
+-- feel it (500 entries ~= 66ms worst case), and above that trade the marker
+-- for the seconds. g:netrw_fastlist_statmax tunes the line; set it huge to
+-- always mark, 0 to never.
+--
+-- A missing type is different — without it the entry cannot be classified at
+-- all, so that stat is not optional. On Plan 9 it never happens (cc9's readdir
+-- reports DT_DIR/DT_REG for every entry from the Dir it already read).
+local DEFAULT_STATMAX = 500
+
+function M.list(dirname)
+  local uv = vim.uv
+  local sep = dirname:sub(-1) == '/' and '' or '/'
+  -- '.' and '..' first, exactly like netrw's readdir prelude; both are
+  -- always directories.
+  local out = { './', '../' }
+  local fs = uv.fs_scandir(dirname)
+  if not fs then
+    return out
+  end
+
+  local names, types = {}, {}
+  while true do
+    local name, t = uv.fs_scandir_next(fs)
+    if not name then
+      break
+    end
+    names[#names + 1] = name
+    types[#names] = t
+  end
+
+  local statmax = vim.g.netrw_fastlist_statmax or DEFAULT_STATMAX
+  local mark_exe = #names <= statmax
+
+  for i = 1, #names do
+    local name, t = names[i], types[i]
+    local st
+    if t == nil or (mark_exe and t == 'file') then
+      st = uv.fs_lstat(dirname .. sep .. name)
+      if st then
+        t = st.type
+      end
+    end
+    if t == 'link' then
+      out[#out + 1] = name .. '@'
+    elseif t == 'socket' then
+      out[#out + 1] = name .. '='
+    elseif t == 'fifo' then
+      out[#out + 1] = name .. '|'
+    elseif t == 'directory' then
+      out[#out + 1] = name .. '/'
+    elseif st and band(st.mode, 73) ~= 0 then -- 0111: executable by anyone
+      out[#out + 1] = name .. '*'
+    else
+      out[#out + 1] = name
+    end
+  end
+  return out
+end
+
+return M
