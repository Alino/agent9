diff --git a/src/nvim/tui/tui.c b/src/nvim/tui/tui.c
index 7d56424..56bcd05 100644
--- a/src/nvim/tui/tui.c
+++ b/src/nvim/tui/tui.c
@@ -168,6 +168,12 @@ void tui_start(TUIData **tui_p, int *width, int *height, char **term, bool *rgb)
   kv_init(tui->urlbuf);
   signal_watcher_init(tui->loop, &tui->winch_handle, tui);
   signal_watcher_start(&tui->winch_handle, sigwinch_cb, SIGWINCH);
+#ifdef __plan9__
+  {
+    extern void tui_plan9_winch_poller_start(void);
+    tui_plan9_winch_poller_start();
